#!/bin/sh
# /etc/init.d/S98capsula-ota
# Boot-independent OTA daemon. Uses start-stop-daemon so it survives rcS/ADB
# session exit and never depends on the Alice launcher or other services.

OTA_BIN=/usr/bin/capsula-ota
OTA_PID=/var/run/capsula-ota.pid
OTA_HOME=/data/ota

start_ota() {
    [ -x "$OTA_BIN" ] || return 0
    mkdir -p "$OTA_HOME"
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -S -b -m -p "$OTA_PID" -x "$OTA_BIN" \
            -- daemon >>/tmp/capsula-ota-boot.log 2>&1
    else
        nohup "$OTA_BIN" daemon >>/tmp/capsula-ota-boot.log 2>&1 &
    fi
}

stop_ota() {
    [ -f "$OTA_PID" ] || return 0
    if command -v start-stop-daemon >/dev/null 2>&1; then
        start-stop-daemon -K -p "$OTA_PID" -x "$OTA_BIN" >/dev/null 2>&1
    else
        pid=$(cat "$OTA_PID" 2>/dev/null || printf '')
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
    fi
    rm -f "$OTA_PID" 2>/dev/null
}

case "${1:-}" in
  start)  start_ota ;;
  stop)   stop_ota ;;
  restart)
    stop_ota
    sleep 1
    start_ota
    ;;
  status)
    [ -x "$OTA_BIN" ] && "$OTA_BIN" status
    ;;
  *)
    printf 'Usage: %s {start|stop|restart|status}\n' "$0" >&2
    exit 1
    ;;
esac
