#!/bin/sh
# /etc/init.d/S99capsula-alice
# Autostart init service for Alice Assistant on VK Capsule Mini

stop_all() {
    killall -9 capsula-alice capsula-yandex wakewordd ring_daemon capsule_onboarding wifi_setup_helper.sh parec 2>/dev/null
    rm -f /var/run/capsula-alice.pid /var/run/capsula-yandex.pid /var/run/wakewordd.pid /var/run/ring_daemon.pid /var/run/capsule_onboarding.pid
}

start_all() {
    echo "Starting Alice Assistant Service..."
    nohup /usr/bin/capsula-alice-launcher.sh >/tmp/capsula-alice-launcher.log 2>&1 &
}

case "$1" in
  start)
    start_all
    ;;
  stop)
    echo "Stopping Alice Assistant Service..."
    stop_all
    ;;
  restart)
    stop_all
    sleep 2
    start_all
    ;;
  status)
    ps | grep -E "capsula-alice|capsula-yandex|wakewordd|ring_daemon|capsule_onboarding|wifi_setup_helper" | grep -v grep
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
