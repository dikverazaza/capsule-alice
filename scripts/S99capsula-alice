#!/bin/sh
# /etc/init.d/S99capsula-alice
# Autostart init service for Alice Assistant on VK Capsule Mini

case "$1" in
  start)
    echo "Starting Alice Assistant Service..."
    /usr/bin/capsula-alice-launcher.sh &
    ;;
  stop)
    echo "Stopping Alice Assistant Service..."
    killall -9 capsula-alice capsula-yandex wakewordd ring_daemon parec 2>/dev/null
    echo "off" > /tmp/ring.fifo 2>/dev/null
    ;;
  restart)
    "$0" stop
    sleep 2
    "$0" start
    ;;
  status)
    pgrep -a capsula-alice
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
